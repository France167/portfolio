---
import AstroIcon from "@/icons/AstroIcon.astro";
import CSSIcon from "@/icons/CSS.astro";
import ExpressIcon from "@/icons/Express.astro";
import GitIcon from "@/icons/Git.astro";
import HTMLIcon from "@/icons/HTML.astro";
import JavaScriptIcon from "@/icons/JavaScript.astro";
import MaterialUIIcon from "@/icons/MaterialUI.astro";
import MongoIcon from "@/icons/Mongo.astro";
import MySqlIcon from "@/icons/MySql.astro";
import NodeIcon from "@/icons/Node.astro";
import ReactIcon from "@/icons/React.astro";
import StackIcon from "@/icons/Stack.astro";
import TailwindIcon from "@/icons/Tailwind.astro";
import TypeScriptIcon from "@/icons/TypeScript.astro";
import WordpressIcon from "@/icons/Wordpress.astro";
---

<section
  class="flex flex-col items-center md:flex-row gap-x-6 justify-center text-pretty"
>
  <div class="order-2 md:order-1">
    <p class="text-white/70 text-lg">
      Hey there! 👋 I'm a Frontend Software Developer based in sunny Málaga,
      Spain, with over 4 years of experience building enterprise-scale web
      applications.
    </p>
    <p class="text-white/70 text-lg mt-4">
      I currently work on HP PrintOS, developing complex React and TypeScript
      solutions within a shared micro-frontend ecosystem. I care about design
      systems, long-lived codebases and cross-application platform work, and
      I've got solid Backend skills with Node.js and Express too.
    </p>
    <p class="text-white/70 text-lg mt-4">
      I thrive on problem-solving and creating smiles for users. Collaboration
      is where the magic happens, and I'm always eager to dive into the latest
      tech trends. Let's join forces and craft some exceptional software
      together! 🚀
    </p>
  </div>
  <img
    loading="lazy"
    src="images/Francesco_cropped.webp"
    alt={"Francesco Fava"}
    class="order-1 object-cover w-64 h-full p-1 mb-6 md:order-2 lg:p-2 lg:w-64 rounded-full bg-purple-200/5 sm:my-12"
  />
</section>
<section>
  <h2
    class="text-white text-2xl lg:text-2xl font-semibold mb-8 flex gap-x-3 items-center mt-16"
  >
    <StackIcon class="size-7 text-white" />
    My Tech Stack
  </h2>

  <div class="logos">
    <div class="logos-slide">
      <HTMLIcon class="img" />
      <CSSIcon class="img" />
      <JavaScriptIcon class="img" />
      <TypeScriptIcon class="img" />
      <ReactIcon class="img" />
      <AstroIcon class="img bg-white/90 rounded-full p-1" />
      <MaterialUIIcon class="img" />
      <TailwindIcon class="img" />
      <NodeIcon class="img" />
      <ExpressIcon class="img bg-white/70 rounded-full p-1" />
      <MongoIcon class="img" />
      <MySqlIcon class="img" />
      <GitIcon class="img" />
      <WordpressIcon class="img" />
    </div>
    <div class="logos-slide">
      <HTMLIcon class="img" />
      <CSSIcon class="img" />
      <JavaScriptIcon class="img" />
      <TypeScriptIcon class="img" />
      <ReactIcon class="img" />
      <AstroIcon class="img bg-white/90 rounded-full p-1" />
      <MaterialUIIcon class="img" />
      <TailwindIcon class="img" />
      <NodeIcon class="img" />
      <ExpressIcon class="img bg-white/70 rounded-full p-1" />
      <MongoIcon class="img" />
      <MySqlIcon class="img" />
      <GitIcon class="img" />
      <WordpressIcon class="img" />
    </div>
  </div>

