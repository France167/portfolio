---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = [
  {
    date: "March 2024 - Present",
    title: "Senior Software Developer - Between Group (HP project)",
    description:
      "Building and evolving web applications for HP as part of Between Group. My focus is on software architecture and on finding the best way to solve each problem, rather than on any single framework: in the age of AI, the right design matters more than the tool. Currently working with React; on previous HP projects I also delivered with Vue and Angular.",
  },
  {
    date: "May 2022 - March 2024",
    title: "Full Stack Web Developer - Releevant",
    description:
      "Development of web applications following UX/UI principles. Front-end built with React, TypeScript, and Material UI. Back-end developed using Node.js, Express, and MongoDB. Managed tasks with Azure DevOps and version control with Git. Collaborated daily within an Agile environment.",
    link: "https://www.releevant.com/",
  },
  {
    date: "November 2021",
    title: "Full Stack Web Developer Bootcamp - Releevant",
    description:
      "I have completed a comprehensive Full Stack Web Developer Bootcamp, where I acquired proficiency in front-end and back-end development, as well as advanced programming techniques. This intensive training encompassed a broad spectrum of skills, including layout design, foundational programming principles, and advanced front-end development. I am equipped with a solid foundation in both the technical and creative aspects of web development, ready to tackle complex challenges and deliver high-quality solutions.",
  },
];
---

<ol class="relative border-s border-gray-200 ml-3">
  {
    EXPERIENCE.map((experience) => (
      <li class="mb-10 ms-4">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
